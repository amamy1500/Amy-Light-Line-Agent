# Copy to .env.local for development. Never commit real values.
# Production values live in the hosting provider's secret settings.

# Public origin Twilio calls; webhook signatures are verified against it.
PUBLIC_BASE_URL=http://localhost:3000

# Twilio (owned by the business's account, with an approved Business profile).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Registered (A2P 10DLC) number that texts alerts to the owner.
TWILIO_ALERT_FROM=

# Server-only Postgres connection (Supabase). Leave empty in development to
# use the embedded database stored in PGLITE_DIR.
DATABASE_URL=
PGLITE_DIR=.data/pglite

# Shared access code for the call inbox (interim, until per-user sign-in).
OPERATOR_TOKEN=

# Alerts: "simulate" (default) records them without sending; "live" sends.
ALERT_MODE=simulate
RESEND_API_KEY=
ALERT_EMAIL_FROM=

# Development seed only (ignored once numbers exist). 555-01xx numbers are fictional.
OWNER_NAME=Amy
OWNER_RING_E164=+15125550199
CLG_TV_NUMBER=+15125550101
CLG_WEB_NUMBER=+15125550102
CLG_PRINT_NUMBER=+15125550103
# The real Christmas Light Guys number (site, TV, QR), bought 2026-10-28. 512-339-9313 is never set here:
# it stays on Amy's own system for every company.
CLG_MAIN_NUMBER=
ALERT_SMS_TO=
ALERT_EMAIL_TO=
# When Amy's cell rings first (Austin time); outside them the assistant answers at once.
# Equal start/end values mean "always ring". Days: 0 = Sunday … 6 = Saturday; empty = every day.
# Amy can change all of this later in Settings → Hours.
RING_START=09:00
RING_END=17:00
RING_DAYS=1,2,3,4,5,6

# Voice agent: "elevenlabs" (needs ELEVENLABS_API_KEY), "simulator" (dev only), or "none".
AGENT_PROVIDER=simulator
ELEVENLABS_API_KEY=
# HMAC secret for the post-call webhook (ElevenLabs settings).
ELEVENLABS_WEBHOOK_SECRET=
# Header secret the agent's tools send; store the same value as an ElevenLabs workspace secret.
AGENT_TOOL_SECRET=
# Optional for scripts/live: a stock voice id (else a premade voice is picked),
# the agent's LLM (default claude-haiku-5-5), and an API origin override (load tests).
ELEVENLABS_VOICE_ID=
ELEVENLABS_LLM=
ELEVENLABS_API_BASE=
# Bearer secret for GET /api/jobs/run (a cron on serverless hosts, or a manual run).
CRON_SECRET=
# Seconds between in-process job sweeps on an always-on host (Render: 60). Empty = none.
JOB_SWEEP_SECONDS=
# Signs web-form render stamps (required in production).
FORM_SECRET=

# Bestline mode (docs/bestline-setup.md): 512-339-9313 forwards to these two
# unpublished numbers. BESTLINE_MISSED_NUMBER = after Amy didn't answer (AI at
# once); SHARED_LINE_NUMBER = forward-all / app offline (rings Amy first).
BESTLINE_MISSED_NUMBER=
# A TwiML Bin URL that rings Amy's cell, then records: Twilio runs it if this app is down.
TWILIO_FALLBACK_URL=

# Sister companies' own numbers and a shared line (numbers we own; empty = not seeded), and the
# numbers a carrier forwards to only after Amy didn't answer (comma-separated).
SUBLIME_PATIO_NUMBER=
THE_FRIDGE_NUMBER=
SHARED_LINE_NUMBER=
CARRIER_RINGS_FIRST=
# "owner_clone" only with Amy's signed consent (scripts/live/clone-voice.ts sets it).
AI_VOICE=stock

# Development seed only: AI mode for the seeded config, agent id, and
# candidate facts treated as approved for demos (recorded as "DEMO SEED (not Amy)").
AI_MODE=off
AGENT_ID=
DEMO_APPROVED_KEYS=

# Render (npm run deploy:render): Account settings → API keys. Stays on this computer.
RENDER_API_KEY=
